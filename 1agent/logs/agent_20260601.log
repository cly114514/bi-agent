2026-06-01 18:02:53,880 - agent - INFO - middleware.py:23 - [tool monitor] 传入参数: {'sql': "\nWITH payment_2023h1 AS (\n    SELECT 用户ID, 访问时间, 购买金额, 停留时间\n    FROM Sheet1\n    WHERE 用户行为 = '支付'\n      AND 购买金额 > 0\n      AND 访问时间 >= '2023-01-01'\n      AND 访问时间 < '2023-07-01'\n),\ncond1 AS (\n    SELECT DISTINCT p1.用户ID, p1.访问时间\n    FROM payment_2023h1 p1\n    WHERE p1.购买金额 < 50\n      AND (\n        SELECT COUNT(*)\n        FROM payment_2023h1 p2\n        WHERE p1.用户ID = p2.用户ID\n          AND p2.购买金额 < 50\n          AND p2.访问时间 >= p1.访问时间\n          AND p2.访问时间 < DATE_ADD(p1.访问时间, INTERVAL 1 HOUR)\n      ) > 3\n),\ncond2 AS (\n    SELECT 用户ID, 访问时间\n    FROM payment_2023h1\n    WHERE 停留时间 < 10\n)\nSELECT \n    p.用户ID,\n    p.访问时间,\n    p.购买金额,\n    CASE \n        WHEN c1.用户ID IS NOT NULL AND c2.用户ID IS NOT NULL THEN '高频小额支付异常 & 短停留支付异常'\n        WHEN c1.用户ID IS NOT NULL THEN '高频小额支付异常'\n        WHEN c2.用户ID IS NOT NULL THEN '短停留支付异常'\n    END AS 异常类型标签\nFROM payment_2023h1 p\nLEFT JOIN cond1 c1 ON p.用户ID = c1.用户ID AND p.访问时间 = c1.访问时间\nLEFT JOIN cond2 c2 ON p.用户ID = c2.用户ID AND p.访问时间 = c2.访问时间\nWHERE c1.用户ID IS NOT NULL OR c2.用户ID IS NOT NULL\nORDER BY p.用户ID, p.访问时间\n"}
