2026-06-01 18:10:58,070 - agent - INFO - middleware.py:23 - [tool monitor] 传入参数: {'sql': "WITH \npayment_log AS (\n    SELECT \n        用户ID, \n        访问时间, \n        购买金额,\n        停留时间,\n        UNIX_TIMESTAMP(访问时间) AS epoch_sec \n    FROM Sheet1 \n    WHERE 用户行为 = '支付' \n      AND 访问时间 >= '2023-01-01' \n      AND 访问时间 < '2023-07-01'\n),\nlag_time AS (\n    SELECT \n        用户ID,\n        访问时间,\n        购买金额,\n        停留时间,\n        epoch_sec,\n        LAG(epoch_sec) OVER (PARTITION BY 用户ID ORDER BY epoch_sec) AS prev_epoch_sec\n    FROM payment_log\n),\ngroup_flag AS (\n    SELECT \n        用户ID,\n        访问时间,\n        购买金额,\n        停留时间,\n        SUM(CASE WHEN prev_epoch_sec IS NULL OR (epoch_sec - prev_epoch_sec) > 3600 THEN 1 ELSE 0 END) \n            OVER (PARTITION BY 用户ID ORDER BY epoch_sec ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS grp\n    FROM lag_time\n),\ngroup_stats AS (\n    SELECT \n        用户ID,\n        访问时间,\n        购买金额,\n        停留时间,\n        grp,\n        COUNT(*) OVER (PARTITION BY 用户ID, grp) AS grp_cnt,\n        MAX(购买金额) OVER (PARTITION BY 用户ID, grp) AS max_amt_in_grp\n    FROM group_flag\n),\nabnormal_frequency AS (\n    SELECT \n        用户ID,\n        访问时间,\n        购买金额,\n        '高频小额支付' AS 异常类型标签\n    FROM group_stats\n    WHERE grp_cnt > 3 \n      AND max_amt_in_grp < 50\n),\nabnormal_short_stay AS (\n    SELECT \n        用户ID,\n        访问时间,\n        购买金额,\n        '停留短暂支付' AS 异常类型标签\n    FROM payment_log\n    WHERE 停留时间 < 10\n)\nSELECT * FROM abnormal_frequency\nUNION ALL\nSELECT * FROM abnormal_short_stay\nORDER BY 用户ID, 访问时间"}
