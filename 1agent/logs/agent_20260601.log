2026-06-01 16:52:49,266 - agent - INFO - middleware.py:23 - [tool monitor] 传入参数: {'sql': "\nWITH monthly_total AS (\n    SELECT DATE_FORMAT(`日期`, '%Y-%m') AS month, `产品类别`, SUM(`总金额`) AS total_amount\n    FROM Sheet1\n    WHERE `日期` LIKE '2023%'\n    GROUP BY DATE_FORMAT(`日期`, '%Y-%m'), `产品类别`\n),\nmonthly_champion AS (\n    SELECT month, `产品类别`, total_amount,\n           ROW_NUMBER() OVER (PARTITION BY month ORDER BY total_amount DESC) AS rn\n    FROM monthly_total\n),\nchampion_categories AS (\n    SELECT DISTINCT `产品类别`\n    FROM monthly_champion\n    WHERE rn = 1\n),\nhalf_year_sales AS (\n    SELECT `产品类别`, DATE_FORMAT(`日期`, '%Y-%m') AS month, SUM(`总金额`) AS monthly_amount\n    FROM Sheet1\n    WHERE `产品类别` IN (SELECT `产品类别` FROM champion_categories)\n      AND DATE_FORMAT(`日期`, '%Y-%m') BETWEEN '2023-07' AND '2023-12'\n    GROUP BY `产品类别`, DATE_FORMAT(`日期`, '%Y-%m')\n),\nmonthly_growth AS (\n    SELECT `产品类别`, month, monthly_amount,\n           LAG(monthly_amount) OVER (PARTITION BY `产品类别` ORDER BY month) AS prev_amount\n    FROM half_year_sales\n)\nSELECT `产品类别`, month,\n       ROUND(monthly_amount, 2) AS 当月销售额,\n       ROUND(prev_amount, 2) AS 上月销售额,\n       ROUND((monthly_amount - prev_amount) / prev_amount * 100, 2) AS 环比增长率_pct\nFROM monthly_growth\nWHERE prev_amount IS NOT NULL AND prev_amount > 0\nORDER BY `产品类别`, month\n"}
